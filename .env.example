MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB=collegefest

# Admin desk login (change before going public)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=change-this-to-a-long-random-string

# Allow non .edu / .ac.in emails in local demo
ALLOW_ANY_EMAIL=true
PORT=8787

# Cloudinary (image uploads in chat). Leave empty to use local disk fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP email delivery via Resend. Leave RESEND_API_KEY empty for demo mode (OTP shown on screen).
RESEND_API_KEY=
EMAIL_FROM=College Fest <onboarding@resend.dev>

# OTP SMS delivery via Twilio (phone logins). Leave empty for demo mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_COUNTRY=91

# Optional: xAI key for discussion-prompt drafting (server-side only)
XAI_API_KEY=